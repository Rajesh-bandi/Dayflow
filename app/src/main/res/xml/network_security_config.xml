<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Cleartext is permitted so a self-hosted AI gateway on the local network can be reached,
         for example http://192.168.1.20:8080/v1. Android blocks cleartext by default, which made
         every LAN gateway configuration fail before the request left the device. Everything this
         app talks to on the public internet (search, page fetching) already uses HTTPS. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
